# Backend Port
PORT=5050

# Frontend URL(s) for CORS — comma-separated for multiple origins (e.g. Vercel previews)
FRONTEND_URL=http://localhost:5173

# Supabase Keys (Update these when your Supabase project is ready)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Code execution engine
# false (default) = local Docker sandbox; true = Piston public API.
# On Vercel/serverless, Piston is always used regardless of this flag.
USE_PISTON=false

# AI features (optional — endpoints return mock responses when unset)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Shared demo account used by the "Explore with Demo Account" button and npm run seed
DEMO_USER_EMAIL=demo@devforge.example.com
DEMO_USER_PASSWORD=devforge-demo-2026!
