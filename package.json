{
  "name": "devforge-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "test": "cd backend && npm test",
    "seed": "cd backend && npm run seed"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "dependencies": {
    "axios": "^1.14.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "openai": "^6.33.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "@supabase/supabase-js": "^2.101.0"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "@types/node": "^25.5.2",
    "@types/express": "^5.0.6",
    "concurrently": "^9.1.0"
  }
}
