# API origin (no trailing /api). In production, the deployed site origin (Vercel) or your API host.
VITE_API_BASE_URL=http://localhost:5050

# Supabase project (public anon key — safe to expose; RLS protects the data)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Set to false where the API runs serverless (no websockets), e.g. Vercel
VITE_ENABLE_REALTIME=true
